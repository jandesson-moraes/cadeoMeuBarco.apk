{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": false,
    "target": "es2017",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "compileOnSave": true,
  "include": [
    "src/**/*"
  ],
  "extends": "expo/tsconfig.base"
}
