  // --- TRAJETO COMPLETO DA PARTIDA ATÉ A POSIÇÃO ATUAL ---
  // O processamento pesado ocorre na Cloud Function. O celular recebe somente
  // uma linha compactada e mantém um cache curto em memória.
  useEffect(() => {
    let cancelado = false;
    const controller = new AbortController();

    const carregarPercurso = async () => {
      if (!barco?.id || !mostrarPercurso) {
        setRotaAoVivo([]);
        setCarregandoPercurso(false);
        return;
      }

      const idsPossiveis = obterIdsPossiveisRastreamento({
        ...barco,
        ...barcoRealtime,
        id: barco?.id,
      });

      if (idsPossiveis.length === 0) {
        setRotaAoVivo([]);
        setCarregandoPercurso(false);
        return;
      }

      const inicioViagemMs = estadoOperacional.inicioRastroMs || 0;
      const rotaOficialAtual = limparCoordenadasRota(rotaOficial?.pontos || []);
      const origemReferencia = rotaOficialAtual[0] || null;
      const chaveCache = `${idsPossiveis.join("|")}:${inicioViagemMs}`;

      const cacheMemoria = cacheTrajetoCompletoMemoria.get(chaveCache);
      if (cacheMemoria && Date.now() - cacheMemoria.salvoEmMs < 5 * 60 * 1000) {
        setRotaAoVivo(cacheMemoria.pontos);
        setCarregandoPercurso(false);
        return;
      }

      setCarregandoPercurso(true);

      try {
        const resultado = await buscarTrajetoCompletoNoServidor({
          barcoIds: idsPossiveis,
          inicioViagemMs,
          origemReferencia,
          signal: controller.signal,
        });

        if (cancelado) return;

        const pontosServidor = otimizarPontosDoRastro(
          resultado.pontos,
          320,
          0.015,
        );

        if (pontosServidor.length > 1) {
          cacheTrajetoCompletoMemoria.set(chaveCache, {
            pontos: pontosServidor,
            salvoEmMs: Date.now(),
          });
          setRotaAoVivo(pontosServidor);
          return;
        }

        throw new Error("Servidor não retornou pontos suficientes.");
      } catch (error) {
        if (cancelado || controller.signal.aborted) return;

        console.log(
          "Servidor do trajeto indisponível; usando consulta curta de segurança:",
          error,
        );

        // Fallback para o app continuar funcional antes do deploy da Function.
        try {
          const pontosRef = collection(
            db,
            "rastreamento",
            idsPossiveis[0],
            "pontos",
          );

          const consulta = firestoreQuery(
            pontosRef,
            orderBy("criado_em", "desc"),
            limit(1200),
          );

          const snapshot = await getDocs(consulta);
          if (cancelado) return;

          const pontosFallback = snapshot.docs
            .map((docSnap) => {
              const dados = docSnap.data();

              return {
                latitude: Number(dados.latitude ?? dados.lat),
                longitude: Number(dados.longitude ?? dados.lng),
                criadoEmMs: converterDataRastroMs(
                  dados.criado_em ?? dados.criadoEm ?? dados.timestamp,
                ),
              };
            })
            .filter(
              (ponto) =>
                Number.isFinite(ponto.latitude) &&
                Number.isFinite(ponto.longitude) &&
                ponto.latitude !== 0 &&
                ponto.longitude !== 0,
            )
            .reverse();

          setRotaAoVivo(otimizarPontosDoRastro(pontosFallback, 180, 0.025));
        } catch (fallbackError) {
          console.log("Erro no fallback do trajeto:", fallbackError);
          if (!cancelado) setRotaAoVivo([]);
        }
      } finally {
        if (!cancelado) setCarregandoPercurso(false);
      }
    };

    void carregarPercurso();

    return () => {
      cancelado = true;
      controller.abort();
    };
  }, [
    barco,
    barcoRealtime,
    estadoOperacional.inicioRastroMs,
    mostrarPercurso,
    rotaOficial?.id,
    rotaOficial?.pontos,
  ]);

  // --- ROTA OFICIAL DEFINIDA NO SISTEMA DE NAVEGAÇÃO ---
  useEffect(() => {
    if (!barco?.id) {
      setRotaOficial(null);
