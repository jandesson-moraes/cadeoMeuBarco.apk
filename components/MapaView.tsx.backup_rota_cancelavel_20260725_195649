    if (temBarco && temPorto) {
      mapRef.current?.fitToCoordinates(
        [
          { latitude: bLat, longitude: bLng },
          { latitude: pLat, longitude: pLng },
        ],
        {
          edgePadding: { top: 80, right: 80, bottom: 120, left: 30 },
